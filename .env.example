# ─── Auth ────────────────────────────────────────────────────
# Auth0 /userinfo endpoint used to resolve the Alexa OAuth token to a user email
AUTH0_USERINFO_URL=https://your-tenant.region.auth0.com/userinfo

# ─── Backend API ─────────────────────────────────────────────
# Base URL of your smart home backend (no trailing slash)
BACKEND_API_URL=https://your-backend-host

# API key your backend requires on every request
API_KEY=your_api_key_here

# ─── Backend API Paths ────────────────────────────────────────
# Endpoint that returns the list of devices for a given email
DEVICE_LIST_PATH=/api/v1/device/list

# Endpoint that sends a control command (on/off/fan speed) to a device
DEVICE_CONTROL_PATH=/api/v1/device/control

# Endpoint that returns the current state of a single device by ID
DEVICE_STATE_PATH=/api/v1/device/state

# ─── Alexa Device Metadata ────────────────────────────────────
# Shown in the Alexa app under device details
MANUFACTURER_NAME=Your Brand Name
MODEL_NAME=Your Device Model Name
